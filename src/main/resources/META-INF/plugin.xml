<idea-plugin>
  <id>com.wecovi.plugin</id>
  <name>Wecovi</name>
  <vendor email="dev@wecovi.com" url="https://wecovi.com">Wecovi</vendor>

  <depends>com.intellij.modules.platform</depends>
  <depends>JavaScript</depends>

  <description><![CDATA[
    Wecovi tools for WebStorm.
  ]]></description>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Covi" factoryClass="com.wecovi.plugin.ui.CoviToolWindowFactory" anchor="left" />
    <fileEditorProvider implementation="com.wecovi.plugin.ui.FlowEditorProvider" />
  </extensions>
</idea-plugin>
